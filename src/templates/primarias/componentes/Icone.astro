---
// Ícones de traço simples (inline, herdam currentColor). Sem arquivos: não entram no prune.
interface Props {
  nome: 'atividades' | 'calendario' | 'regimento' | 'contrato' | 'estrela' | 'seta' | 'menu' | 'download';
  classe?: string;
}
const { nome, classe = 'ico-svg' } = Astro.props;
---
<svg class={classe} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {nome === 'atividades' && <><circle cx="12" cy="12" r="9" /><path d="M12 3a15 15 0 0 1 0 18M3.6 9h16.8M3.6 15h16.8" /></>}
  {nome === 'calendario' && <><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M8 3v4M16 3v4M3 10h18M8 14h2M14 14h2M8 17h2" /></>}
  {nome === 'regimento' && <><path d="M6 3h9l4 4v14H6z" /><path d="M14 3v5h5M9 12h7M9 16h7" /></>}
  {nome === 'contrato' && <><path d="M5 3h10l4 4v14H5z" /><path d="M9 17c1.5-2 2.5-2 3 0s1.5 1 3-1M9 9h6" /></>}
  {nome === 'estrela' && <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" />}
  {nome === 'seta' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {nome === 'download' && <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />}
  {nome === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
</svg>
